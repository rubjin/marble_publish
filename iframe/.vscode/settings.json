{
  // ==========================================================================
  // Live Sass Compiler (glenn2223.live-sass) 설정
  // ※ iframe 폴더를 VS Code 작업 폴더로 열어야 적용됩니다. (경로는 iframe 폴더 기준)
  // ==========================================================================

  // 출력: scss 파일 위치(~) 기준 ../css → styles/css/ 에 css 생성
  "liveSassCompile.settings.formats": [
    {
      "format": "expanded",
      "extensionName": ".css",
      "savePath": "~/../css"
    }
  ],

  // 컴파일 대상: styles/scss 바로 아래 진입 파일만 (화면 추가 시 진입 파일만 만들면 자동 포함)
  "liveSassCompile.settings.includeItems": [
    "/styles/scss/*.scss"
  ],

  // 제외: 공통 파일(common.scss)은 진입 파일에서 불러오므로 단독 컴파일하지 않음
  "liveSassCompile.settings.excludeList": [
    "/**/node_modules/**",
    "/.vscode/**",
    "/styles/scss/common.scss"
  ],

  // _ 로 시작하는 파일은 partial (단독 컴파일 안 함)
  "liveSassCompile.settings.partialsList": [
    "/**/_*.s[ac]ss"
  ],

  // 소스맵 / 벤더 프리픽스 자동 추가 안 함
  "liveSassCompile.settings.generateMap": false,
  "liveSassCompile.settings.autoprefix": false
}
